# JE Guard Backend Environment Configuration Example
JE_GUARD_MODE=local
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
ALLOWED_ORIGINS=http://localhost:5173

# AWS Settings (used when JE_GUARD_MODE=aws)
# BUCKET=your-data-bucket-name
# TABLE=your-dynamodb-table-name
# GEMINI_SECRET_ID=your-secretsmanager-secret-name
# AWS_REGION=us-east-1

